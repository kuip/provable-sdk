{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "provable-proof-js": ["../provable-proof-js/dist/index.d.ts"],
      "provable-sdk-js": ["../provable-sdk-js/dist/index.d.ts"]
    },
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "resolveJsonModule": true
  },
  "include": ["src"]
}
