{
  "name": "@kuip/provable-ui",
  "version": "0.0.8",
  "description": "Reusable proof UIs for Provable/Kayros",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./esm": {
      "import": "./dist/index.js"
    },
    "./browser": {
      "import": "./dist/browser/provable-sdk-ui.iife.js"
    },
    "./styles.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:browser": "vite build --config vite.config.browser.ts",
    "dev": "vite",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@kuip/provable-proof": "file:../provable-proof-js",
    "@kuip/provable-sdk": "file:../provable-sdk-js"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
